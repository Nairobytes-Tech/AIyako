{
  "name": "kioo-ai",
  "version": "1.0.0",
  "description": "A local offline AI assistant using QVAC SDK for local LLM inference",
  "type": "module",
  "main": "src/agent.js",
  "scripts": {
    "start": "QVAC_CONFIG_PATH=./qvac.config.json node src/agent.js",
    "dev": "QVAC_CONFIG_PATH=./qvac.config.json node src/agent.js",
    "server": "QVAC_CONFIG_PATH=./qvac.config.json node src/ui/server.js",
    "test": "node --test \"tests/**/*.test.js\"",
    "lint": "node --check src/**/*.js"
  },
  "keywords": ["ai", "offline", "llm", "qvac", "sqlite"],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@qvac/sdk": "^0.22.0",
    "zod": "^4.6.5"
  }
}
