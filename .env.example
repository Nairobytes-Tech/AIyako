# QVAC Configuration
# Copy this file to .env.local and adjust as needed
QVAC_CONFIG_PATH=./qvac.config.json

# Primary local model (downloaded during setup)
QVAC_MODEL_PATH=./models/Qwen3.5-4B-Q4_K_M.gguf

# Optional: larger local model for complex turns
KIOO_ESCALATION_MODEL_PATH=./models/Llama-3.2-1B-Instruct-Q4_0.gguf

# Optional: self-hosted SearXNG instance for web_search
SEARXNG_URL=http://localhost:8080

# Optional: run the Python Deep Agents service and proxy chat to it
# MODEL_BASE_URL=http://localhost:8000/v1
MODEL_PATH=./models/Qwen3.5-4B-Q4_K_M.gguf
MODEL_NAME=qwen3.5-4b-local
FALLBACK_MODEL_PATH=./models/qwen3-0.6b-q4_0.gguf
FALLBACK_MODEL=qwen3-0.6b-local
KIOO_AGENT_URL=http://localhost:8001
KIOO_AGENT_TIMEOUT_MS=300000

# Optional: MCP Gateway and sandbox
MCP_GATEWAY_URL=http://localhost:8002
MCP_GATEWAY_SECRET=kioo-dev-secret
KIOO_USE_LANGGRAPH=0
KIOO_SANDBOX_DOCKER=0

# Optional: comma-separated tools that require approval
# KIOO_APPROVAL_TOOLS=save_note,create_task

# Optional: server binding and model-less mode
# PORT=3000
# HOST=localhost
# KIOO_SKIP_MODEL=1
