# QVAC Configuration
# Copy this file to .env.local and adjust as needed
QVAC_CONFIG_PATH=./qvac.config.json

# Optional: override the primary local model path
# QVAC_MODEL_PATH=./models/qwen3-0.6b-q4_0.gguf

# Optional: larger local model for complex turns
# KIOO_ESCALATION_MODEL_PATH=./models/Llama-3.2-1B-Instruct-Q4_0.gguf

# Optional: self-hosted SearXNG instance for web_search
# SEARXNG_URL=http://localhost:8080

# Optional: comma-separated tools that require approval
# KIOO_APPROVAL_TOOLS=save_note,create_task

# Optional: server binding and model-less mode
# PORT=3000
# HOST=localhost
# KIOO_SKIP_MODEL=1
